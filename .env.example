# MongoDB Atlas connection string (Atlas → Connect → Drivers)
# Example: mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/efootball?retryWrites=true&w=majority
DATABASE_URL=""

# Long random string used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Public site URL (used in password-reset emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# First super admin, created by `npm run db:seed` (password: 12+ chars, upper, lower, number)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_USERNAME="admin"
ADMIN_NAME="Site Administrator"

# SMTP for password-reset emails (optional — without it the reset link is printed in the server log)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
